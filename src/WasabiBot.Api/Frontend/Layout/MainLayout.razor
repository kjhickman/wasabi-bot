@inherits LayoutComponentBase

<div class="min-h-screen bg-base-200">
    <header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/90 backdrop-blur">
        <nav class="navbar relative w-full gap-3 px-4 md:px-6" aria-label="Primary navigation">
            <div class="flex-1">
                <a class="btn btn-ghost px-2 text-lg font-semibold normal-case" href="/" aria-label="Wasabi Bot home">
                    <strong>Wasabi Bot</strong>
                </a>
            </div>

            <AuthorizeView>
                <Authorized Context="authState">
                    @{
                        var displayName = authState.User.DisplayName;
                        var avatarUrl = authState.User.DiscordAvatarUrl;
                        var avatarInitial = displayName[..1].ToUpperInvariant();
                    }

                    <NavJoinVoiceButton />

                    <form id="nav-search-form" class="absolute left-1/2 top-1/2 hidden w-96 -translate-x-1/2 -translate-y-1/2 lg:w-[32rem] xl:w-[36rem] md:block" action="/search" method="get" role="search">
                        <label class="input input-bordered flex h-11 w-full items-center gap-2 rounded-2xl border-base-300 bg-base-100/95 shadow-sm focus-within:border-base-content/20 focus-within:outline-none" for="nav-search-query">
                            <LucideIcon Name="LucideIconName.Search" Class="size-4 shrink-0 text-base-content/50" />
                            <span class="sr-only">Search music</span>
                            <input id="nav-search-query"
                                   class="grow text-sm focus:outline-none"
                                   type="search"
                                   name="query"
                                   placeholder="Search songs or radio stations..."
                                   autocomplete="off" />
                        </label>
                    </form>

                    <div class="flex flex-none items-center gap-2">
                        <div class="dropdown dropdown-end">
                            <button id="account-menu-button"
                                    type="button"
                                    class="block cursor-pointer rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                    aria-haspopup="menu">
                                @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                {
                                    <img id="header-user-avatar" class="size-10 rounded-full object-cover" src="@avatarUrl" alt="@displayName" />
                                }
                                else
                                {
                                    <span id="header-user-avatar-fallback" class="flex size-10 items-center justify-center rounded-full border border-base-300 bg-base-100 text-sm font-semibold" aria-hidden="true">@avatarInitial</span>
                                }
                            </button>

                            <div id="account-menu-panel"
                                 tabindex="-1"
                                  class="dropdown-content z-50 mt-3 w-64 rounded-box border border-base-300 bg-base-100 p-3 shadow-lg"
                                  role="menu"
                                  aria-labelledby="account-menu-button">
                                 <fieldset class="space-y-2.5">
                                     <legend class="text-xs font-semibold uppercase tracking-[0.2em] text-base-content/60">Theme</legend>
                                     <div class="join w-full">
                                        <input id="theme-preference-light"
                                               class="btn btn-sm join-item flex-1"
                                               type="radio"
                                               name="theme-preference"
                                               value="light"
                                               aria-label="Light"
                                               data-theme-preference />
                                        <input id="theme-preference-dark"
                                               class="btn btn-sm join-item flex-1"
                                               type="radio"
                                               name="theme-preference"
                                               value="dark"
                                               aria-label="Dark"
                                               data-theme-preference />
                                        <input id="theme-preference-system"
                                               class="btn btn-sm join-item flex-1"
                                               type="radio"
                                               name="theme-preference"
                                               value="system"
                                               aria-label="System"
                                               data-theme-preference />
                                     </div>
                                 </fieldset>

                                 <div class="mt-3 space-y-1 border-t border-base-300 pt-3">
                                     <NavLink id="nav-link-creds"
                                              class="btn btn-ghost btn-sm w-full justify-start gap-2"
                                              href="/creds"
                                              Match="NavLinkMatch.Prefix"
                                              ActiveClass="btn-active"
                                              role="menuitem"
                                              data-wasabi-close-dropdown>
                                         <LucideIcon Name="LucideIconName.KeyRound" Class="size-4 shrink-0" />
                                         <span>API Access</span>
                                     </NavLink>

                                     <form action="/logout" method="post">
                                         <AntiforgeryToken />
                                         <button id="logout-button" class="btn btn-ghost btn-sm w-full justify-start gap-2" type="submit">
                                             <LucideIcon Name="LucideIconName.LogOut" Class="size-4 shrink-0" />
                                             <span>Log out</span>
                                         </button>
                                     </form>
                                 </div>
                             </div>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>
    </header>

    <AuthorizeView>
        <Authorized>
            <div class="grid w-full md:grid-cols-[13rem_minmax(0,1fr)]">
                <aside class="border-b border-base-300 px-4 py-3 md:sticky md:top-16 md:h-[calc(100vh-4rem)] md:border-b-0 md:border-r md:px-3 md:py-6" aria-label="Primary sections">
                    <nav id="side-nav" class="flex gap-2 overflow-x-auto md:h-full md:flex-col md:overflow-visible" aria-label="Primary sections">
                        <NavLink id="music-tab-live" class="side-nav-link" href="/" Match="NavLinkMatch.All" ActiveClass="side-nav-link-active">
                            <LucideIcon Name="LucideIconName.Disc3" Class="size-4 shrink-0" />
                            <span>Live</span>
                        </NavLink>
                        <NavLink id="music-tab-favorites" class="side-nav-link" href="/library" ActiveClass="side-nav-link-active">
                            <LucideIcon Name="LucideIconName.Heart" Class="size-4 shrink-0" />
                            <span>Favorites</span>
                        </NavLink>
                        <span id="music-tab-top-played" class="side-nav-link side-nav-link-disabled" aria-disabled="true">
                            <LucideIcon Name="LucideIconName.ChartNoAxesColumn" Class="size-4 shrink-0" />
                            <span>Top Played</span>
                        </span>
                        <NavLink id="side-nav-api-access" class="side-nav-link md:mt-auto" href="/creds" ActiveClass="side-nav-link-active">
                            <LucideIcon Name="LucideIconName.KeyRound" Class="size-4 shrink-0" />
                            <span>API Access</span>
                        </NavLink>
                    </nav>
                </aside>

                <main class="min-w-0 px-4 py-8 md:px-8 md:py-12">
                    <div class="space-y-6">
                        @Body
                    </div>
                </main>
            </div>
        </Authorized>
        <NotAuthorized>
            <main class="mx-auto w-full max-w-6xl px-4 py-8 md:px-6 md:py-10">
                <div class="space-y-6">
                    @Body
                </div>
            </main>
        </NotAuthorized>
    </AuthorizeView>
</div>
