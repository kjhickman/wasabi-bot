@namespace WasabiBot.Api.Frontend.Layout
@using System.Security.Claims
@using Microsoft.Extensions.DependencyInjection
@using WasabiBot.Api.Features.Music

@if (CanJoin)
{
    <button id="music-join-channel"
            class="btn btn-primary btn-sm music-navbar-join"
            type="button"
            title="Join #@_userChannel!.VoiceChannelName in @_userChannel.GuildName"
            disabled="@_isSubmitting"
            @onclick="JoinUserChannelAsync">
        <LucideIcon Name="LucideIconName.Music" Class="size-4" />
        <span>Join voice</span>
    </button>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    private ulong? _userId;
    private UserVoiceChannel? _userChannel;
    private bool _isSubmitting;
    private IMusicDashboardService? _musicDashboardService;
    private IMusicDashboardControlService? _musicDashboardControlService;

    private bool CanJoin => _userChannel is { BotSharesChannel: false, BotIsConnectedInGuild: false };

    protected override async Task OnInitializedAsync()
    {
        _musicDashboardService = Services.GetService<IMusicDashboardService>();
        _musicDashboardControlService = Services.GetService<IMusicDashboardControlService>();
        if (_musicDashboardService is null || _musicDashboardControlService is null)
        {
            return;
        }

        var authState = await AuthenticationStateTask;
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!ulong.TryParse(userIdClaim, out var userId))
        {
            return;
        }

        _userId = userId;
        await RefreshUserChannelAsync();
    }

    private async Task JoinUserChannelAsync()
    {
        var controlService = _musicDashboardControlService;
        if (_userId is null || _isSubmitting || controlService is null)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            await controlService.JoinUserChannelAsync(_userId.Value);
            await RefreshUserChannelAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task RefreshUserChannelAsync()
    {
        var userId = _userId;
        if (userId is null)
        {
            return;
        }

        var dashboardService = _musicDashboardService;
        if (dashboardService is null)
        {
            return;
        }

        var session = await dashboardService.GetActiveSessionAsync(userId.Value);
        _userChannel = session?.UserChannel;
    }
}
