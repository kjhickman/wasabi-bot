@namespace WasabiBot.Api.Frontend.Modules.Music
@using WasabiBot.Api.Frontend.Shared
@using WasabiBot.Api.Features.Music

@{
    var canJoinUserChannel = Session?.UserChannel is { BotSharesChannel: false, BotIsConnectedInGuild: false };
    var isBotBusyElsewhere = Session?.UserChannel is { BotSharesChannel: false, BotIsConnectedInGuild: true };
    var isEmptyRoom = Session is not null
        && !canJoinUserChannel
        && !isBotBusyElsewhere
        && Session.NowPlaying is null
        && Session.Queue.Count == 0;
}

@if (Session is null)
{
    <article class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm music-live-card music-live-card--empty" aria-label="Live room state">
        <div class="music-live-empty-state">
            <div class="music-live-empty-state__card">
                <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Join a voice channel</h2>
                <p class="text-base leading-7 text-base-content/70">Hop into an eligible Discord voice channel, then come back here to invite Wasabi Bot and control music.</p>
            </div>
        </div>
    </article>
}
else
{
    <div class="music-live-layout">
        <article class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm @(canJoinUserChannel || isBotBusyElsewhere || isEmptyRoom ? "music-live-card music-live-card--empty" : "music-live-card")" aria-label="Live player and queue">
            @if (canJoinUserChannel)
            {
                <div class="music-live-empty-state">
                    <div class="music-live-empty-state__card">
                        <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Ready to join your channel?</h2>
                        <p class="text-base leading-7 text-base-content/70">Invite Wasabi Bot into your voice channel to unlock playback controls and queue management here.</p>
                        <button id="music-join-channel-inline"
                                class="btn btn-primary btn-lg"
                                type="button"
                                disabled="@IsSubmittingAction"
                                title="@($"Join #{Session.UserChannel!.VoiceChannelName} in {Session.UserChannel.GuildName}")"
                                @onclick="OnJoinVoice">
                            <LucideIcon Name="LucideIconName.Music" Class="size-5" />
                            <span>Join voice</span>
                        </button>
                    </div>
                </div>
            }
            else if (isBotBusyElsewhere)
            {
                <div class="music-live-empty-state">
                    <div class="music-live-empty-state__card">
                        <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Wasabi Bot is busy elsewhere</h2>
                        <p class="text-base leading-7 text-base-content/70">Wasabi Bot is already connected to another voice channel in this server. Join that channel or wait for it to disconnect.</p>
                    </div>
                </div>
            }
            else if (isEmptyRoom)
            {
                <div class="music-live-empty-state">
                    <div class="music-live-empty-state__card">
                        <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Nothing queued yet</h2>
                        <p class="text-base leading-7 text-base-content/70">Search for a song or radio station to start the room.</p>
                    </div>
                </div>
            }
            else
            {
                @if (Session.NowPlaying is null)
                {
                    <p id="music-now-playing-empty">Nothing is playing right now.</p>
                }
                else
                {
                    <div class="music-live-player">
                        @if (!string.IsNullOrWhiteSpace(Session.NowPlaying.ArtworkUrl))
                        {
                            <img id="music-artwork"
                                 class="music-live-player__artwork"
                                 src="@Session.NowPlaying.ArtworkUrl"
                                 alt="Artwork for @Session.NowPlaying.Title" />
                        }
                        else
                        {
                            <div id="music-artwork" class="music-artwork-placeholder music-live-player__artwork" aria-hidden="true">
                                <LucideIcon Name="LucideIconName.Disc3" Class="size-10" />
                            </div>
                        }

                        <div id="music-now-playing-track" class="music-live-player__details">
                            <div class="music-live-player__title">
                                <strong>@Session.NowPlaying.Title</strong>
                                @if (!Session.NowPlaying.IsRadio)
                                {
                                    <span>@($"by {Session.NowPlaying.Author}")</span>
                                }
                            </div>

                              <section id="music-controls" class="music-controls" aria-label="Playback controls">
                                  <button id="music-toggle-pause"
                                          class="btn btn-lg btn-outline btn-square"
                                          type="button"
                                          disabled="@IsSubmittingAction"
                                          aria-label="@(Session.PlaybackState == "Paused" ? "Resume playback" : "Pause playback")"
                                          @onclick="OnTogglePause">
                                    <LucideIcon Name="@(Session.PlaybackState == "Paused" ? LucideIconName.Play : LucideIconName.Pause)" Class="size-6" />
                                </button>
                                  <button id="music-skip"
                                          class="btn btn-lg btn-outline btn-square"
                                          type="button"
                                          disabled="@IsSubmittingAction"
                                          aria-label="Skip track"
                                          @onclick="OnSkip">
                                      <LucideIcon Name="LucideIconName.SkipForward" Class="size-6" />
                                  </button>
                                  <button id="music-stop"
                                          class="btn btn-lg btn-outline btn-square"
                                          type="button"
                                          disabled="@IsSubmittingAction"
                                          aria-label="Stop playback"
                                          @onclick="OnStop">
                                      <LucideIcon Name="LucideIconName.Stop" Class="size-6" />
                                  </button>
                              </section>
                        </div>
                    </div>

                    <div class="divider" aria-hidden="true"></div>

                    <div class="music-live-card__queue-top">
                        <button type="button"
                                class="btn btn-sm btn-ghost"
                                @onclick="OnClearQueue"
                                disabled="@(IsSubmittingAction || Session.Queue.Count == 0)">
                            Clear queue
                        </button>
                    </div>

                    @if (Session.Queue.Count == 0)
                    {
                        <p id="music-queue-empty">The queue is empty.</p>
                    }
                    else
                    {
                        <div class="music-queue-table-wrap">
                            <table class="table table-zebra">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Track</th>
                                        <th scope="col">Duration</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody id="music-queue-list">
                                    @foreach (var item in Session.Queue)
                                    {
                                        <tr>
                                            <td class="w-12 align-middle text-base-content/70">@item.Position</td>
                                            <td>
                                                <div class="music-queue-table__track-row">
                                                    <div class="music-queue-table__reorder-actions">
                                                        <button type="button"
                                                                class="btn btn-xs btn-ghost btn-square"
                                                                @onclick="() => OnMoveQueueItemUp.InvokeAsync(item)"
                                                                disabled="@(IsSubmittingAction || item.Position == 1)"
                                                                aria-label="Move @item.Track.Title up">
                                                            <LucideIcon Name="LucideIconName.ChevronUp" Class="size-4" />
                                                        </button>
                                                        <button type="button"
                                                                class="btn btn-xs btn-ghost btn-square"
                                                                @onclick="() => OnMoveQueueItemDown.InvokeAsync(item)"
                                                                disabled="@(IsSubmittingAction || item.Position == Session.Queue.Count)"
                                                                aria-label="Move @item.Track.Title down">
                                                            <LucideIcon Name="LucideIconName.ChevronDown" Class="size-4" />
                                                        </button>
                                                    </div>

                                                    <div class="music-queue-table__track">
                                                        <strong>@item.Track.Title</strong>
                                                        @if (!item.Track.IsRadio)
                                                        {
                                                            <span>@item.Track.Author</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="align-middle">@item.Track.DurationText</td>
                                            <td class="align-middle">
                                                <div class="music-queue-table__actions">
                                                    <button type="button"
                                                            class="btn btn-sm btn-ghost btn-square"
                                                            @onclick="() => OnRemoveQueueItem.InvokeAsync(item)"
                                                            disabled="@IsSubmittingAction"
                                                            aria-label="Remove @item.Track.Title from queue">
                                                        <LucideIcon Name="LucideIconName.Trash2" Class="size-4" />
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            }
        </article>
    </div>
}

@code {
    [Parameter]
    public ActiveMusicSession? Session { get; set; }

    [Parameter]
    public bool IsSubmittingAction { get; set; }

    [Parameter]
    public EventCallback OnTogglePause { get; set; }

    [Parameter]
    public EventCallback OnSkip { get; set; }

    [Parameter]
    public EventCallback OnStop { get; set; }

    [Parameter]
    public EventCallback OnJoinVoice { get; set; }

    [Parameter]
    public EventCallback<MusicQueueItemSnapshot> OnRemoveQueueItem { get; set; }

    [Parameter]
    public EventCallback<MusicQueueItemSnapshot> OnMoveQueueItemUp { get; set; }

    [Parameter]
    public EventCallback<MusicQueueItemSnapshot> OnMoveQueueItemDown { get; set; }

    [Parameter]
    public EventCallback OnClearQueue { get; set; }
}
