@namespace WasabiBot.Api.Frontend.Modules.Music
@using WasabiBot.Api.Frontend.Shared
@using WasabiBot.Api.Features.Music

<div class="music-page-stack">
    @if (HasSearchAttempt && !string.IsNullOrWhiteSpace(SearchError))
    {
        <p id="music-search-error" class="alert alert-warning">@SearchError</p>
    }

    @if (IsSearching)
    {
        <p id="music-search-loading" class="alert border-base-300 bg-base-100 text-base-content/80">Searching music...</p>
    }

    @if (SearchResults is not null)
    {
        @if (TopSong is not null)
        {
            <div class="music-search-hero-row">
            <article id="music-top-song" class="music-search-hero rounded-box border border-base-300 bg-base-100 p-5 shadow-sm" aria-labelledby="music-top-song-heading">
                <p id="music-top-song-heading" class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Top result</p>
                <div class="music-search-hero__body">
                    @if (!string.IsNullOrWhiteSpace(TopSong.ArtworkUrl))
                    {
                        <img class="music-search-hero__artwork" src="@TopSong.ArtworkUrl" alt="Artwork for @TopSong.Title" />
                    }
                    else
                    {
                        <div class="music-artwork-placeholder music-search-hero__artwork" aria-hidden="true">
                            <LucideIcon Name="LucideIconName.Disc3" Class="size-12" />
                        </div>
                    }

                    <div class="music-search-hero__details">
                        <strong>@TopSong.Title</strong>
                        <span>@TopSong.Author</span>
                        <div class="music-now-playing__meta-row">
                            <span class="music-search-result-item__duration">@TopSong.DurationText</span>
                        </div>
                    </div>

                    <div class="music-search-hero__actions">
                        <button class="btn btn-primary" type="button" disabled="@(IsSubmittingAction || !HasSharedSession)" @onclick="() => OnQueueSong.InvokeAsync(TopSong)">
                            <LucideIcon Name="LucideIconName.ListPlus" Class="size-4" />
                            <span>Add to queue</span>
                        </button>
                        <button class="btn btn-outline" type="button" disabled="@(IsSubmittingAction || !HasSharedSession)" @onclick="() => OnPlaySongNext.InvokeAsync(TopSong)">
                            <LucideIcon Name="LucideIconName.Play" Class="size-4" />
                            <span>Play next</span>
                        </button>
                        <button class="btn @(TopSong.IsFavorited ? "btn-primary" : "btn-outline")" type="button" disabled="@IsSubmittingAction" @onclick="() => OnSaveSongFavorite.InvokeAsync(TopSong)" aria-label="@(TopSong.IsFavorited ? $"Remove {TopSong.Title} from favorites" : $"Favorite {TopSong.Title}")">
                            <LucideIcon Name="@(TopSong.IsFavorited ? LucideIconName.HeartMinus : LucideIconName.HeartPlus)" Class="size-4" />
                            <span>@(TopSong.IsFavorited ? "Remove from favorites" : "Add to favorites")</span>
                        </button>
                    </div>
                </div>
            </article>
            </div>
        }

        <div class="music-search-sections">
            @if (RemainingSongs.Count > 0)
            {
                <article class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm space-y-4" aria-labelledby="music-song-results-heading">
                    <p id="music-song-results-heading" class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Songs</p>

                    <ul id="music-song-results" class="music-search-result-list">
                        @foreach (var song in RemainingSongs)
                        {
                            <li class="music-search-result-item music-search-result-item--dense">
                                <div class="music-search-result-item__row">
                                    <div class="music-search-result-item__content">
                                    @if (!string.IsNullOrWhiteSpace(song.ArtworkUrl))
                                    {
                                        <img class="music-search-result-item__artwork" src="@song.ArtworkUrl" alt="Artwork for @song.Title" />
                                    }
                                    else
                                    {
                                        <div class="music-artwork-placeholder music-search-result-item__artwork" aria-hidden="true">
                                            <LucideIcon Name="LucideIconName.Disc3" Class="size-7" />
                                        </div>
                                    }
                                        <div class="music-search-result-item__details">
                                            <strong class="music-search-result-item__title" title="@song.Title">@song.Title</strong>
                                            <span>@song.Author</span>
                                        </div>
                                    </div>

                                    <div class="music-search-result-item__actions music-search-result-item__actions--right">
                                        <span class="music-search-result-item__duration">@song.DurationText</span>
                                        <button class="btn btn-ghost btn-sm btn-square" type="button" disabled="@(IsSubmittingAction || !HasSharedSession)" @onclick="() => OnQueueSong.InvokeAsync(song)" aria-label="Add @song.Title to queue" title="Add to queue">
                                            <LucideIcon Name="LucideIconName.ListPlus" Class="size-5" />
                                        </button>
                                        <div class="dropdown dropdown-end">
                                            <button class="btn btn-ghost btn-sm btn-square" type="button" tabindex="0" aria-label="More actions for @song.Title">
                                                <LucideIcon Name="LucideIconName.EllipsisVertical" Class="size-5" />
                                            </button>
                                            <ul class="dropdown-content menu z-20 w-44 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg" tabindex="0">
                                                <li><button type="button" disabled="@(IsSubmittingAction || !HasSharedSession)" @onclick="() => OnPlaySongNext.InvokeAsync(song)"><LucideIcon Name="LucideIconName.Play" Class="size-4" />Play next</button></li>
                                                <li><button type="button" disabled="@(IsSubmittingAction || !HasSharedSession)" @onclick="() => OnQueueSong.InvokeAsync(song)"><LucideIcon Name="LucideIconName.ListPlus" Class="size-4" />Add to queue</button></li>
                                                <li><button type="button" disabled="@IsSubmittingAction" @onclick="() => OnSaveSongFavorite.InvokeAsync(song)"><LucideIcon Name="@(song.IsFavorited ? LucideIconName.HeartMinus : LucideIconName.HeartPlus)" Class="size-4" />@(song.IsFavorited ? "Remove from favorites" : "Add to favorites")</button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </article>
            }

            @if (SearchResults.Stations.Count > 0)
            {
                <article class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm space-y-4" aria-labelledby="music-station-results-heading">
                    <p id="music-station-results-heading" class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Stations</p>

                    <ul id="music-station-results" class="music-search-result-list">
                        @foreach (var station in SearchResults.Stations)
                        {
                            <li class="music-search-result-item music-search-result-item--dense">
                                <div class="music-search-result-item__row">
                                    <div class="music-search-result-item__content">
                                    @if (!string.IsNullOrWhiteSpace(station.ArtworkUrl))
                                    {
                                        <img class="music-search-result-item__artwork" src="@station.ArtworkUrl" alt="Artwork for @station.Name" />
                                    }
                                    else
                                    {
                                        <div class="music-artwork-placeholder music-search-result-item__artwork" aria-hidden="true">
                                            <LucideIcon Name="LucideIconName.Disc3" Class="size-7" />
                                        </div>
                                    }
                                        <div class="music-search-result-item__details">
                                            <strong class="music-search-result-item__title" title="@station.Name">@station.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(station.Country))
                                            {
                                                <span>@station.Country</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="music-search-result-item__actions music-search-result-item__actions--right">
                                        <button class="btn btn-ghost btn-sm btn-square" type="button" disabled="@(IsSubmittingAction || !HasSharedSession)" @onclick="() => OnQueueStation.InvokeAsync(station)" aria-label="Add @station.Name to queue" title="Add to queue">
                                            <LucideIcon Name="LucideIconName.ListPlus" Class="size-5" />
                                        </button>
                                        <div class="dropdown dropdown-end">
                                            <button class="btn btn-ghost btn-sm btn-square" type="button" tabindex="0" aria-label="More actions for @station.Name">
                                                <LucideIcon Name="LucideIconName.EllipsisVertical" Class="size-5" />
                                            </button>
                                            <ul class="dropdown-content menu z-20 w-44 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg" tabindex="0">
                                                <li><button type="button" disabled="@(IsSubmittingAction || !HasSharedSession)" @onclick="() => OnPlayStationNext.InvokeAsync(station)"><LucideIcon Name="LucideIconName.Play" Class="size-4" />Play next</button></li>
                                                <li><button type="button" disabled="@(IsSubmittingAction || !HasSharedSession)" @onclick="() => OnQueueStation.InvokeAsync(station)"><LucideIcon Name="LucideIconName.ListPlus" Class="size-4" />Add to queue</button></li>
                                                <li><button type="button" disabled="@IsSubmittingAction" @onclick="() => OnSaveRadioFavorite.InvokeAsync(station)"><LucideIcon Name="@(station.IsFavorited ? LucideIconName.HeartMinus : LucideIconName.HeartPlus)" Class="size-4" />@(station.IsFavorited ? "Remove from favorites" : "Add to favorites")</button></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public bool IsSearching { get; set; }

    [Parameter]
    public string? SearchError { get; set; }

    [Parameter]
    public bool HasSearchAttempt { get; set; }

    [Parameter]
    public MusicDashboardSearchResults? SearchResults { get; set; }

    [Parameter]
    public bool IsSubmittingAction { get; set; }

    [Parameter]
    public bool HasSharedSession { get; set; }

    [Parameter]
    public EventCallback OnSearch { get; set; }

    [Parameter]
    public EventCallback<MusicDashboardSongSearchResult> OnQueueSong { get; set; }

    [Parameter]
    public EventCallback<MusicDashboardSongSearchResult> OnPlaySongNext { get; set; }

    [Parameter]
    public EventCallback<MusicDashboardSongSearchResult> OnSaveSongFavorite { get; set; }

    [Parameter]
    public EventCallback<MusicDashboardRadioSearchResult> OnQueueStation { get; set; }

    [Parameter]
    public EventCallback<MusicDashboardRadioSearchResult> OnPlayStationNext { get; set; }

    [Parameter]
    public EventCallback<MusicDashboardRadioSearchResult> OnSaveRadioFavorite { get; set; }

    private MusicDashboardSongSearchResult? TopSong => SearchResults?.Songs.FirstOrDefault();

    private IReadOnlyList<MusicDashboardSongSearchResult> RemainingSongs => SearchResults?.Songs.Skip(1).ToArray() ?? [];
}
