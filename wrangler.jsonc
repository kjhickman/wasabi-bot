{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discord-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "exports": {
    "DiscordGateway": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "durable_objects": {
    "bindings": [{ "name": "DISCORD_GATEWAY", "class_name": "DiscordGateway" }],
  },
  "vars": {
    "GATEWAY_MODE": "dev",
  },
  "env": {
    "prod": {
      "name": "discord-bot-prod",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "DISCORD_GATEWAY", "class_name": "DiscordGateway" }],
        "code_update_strategy": { "mode": "immediate" },
      },
      "vars": {
        "GATEWAY_MODE": "prod",
      },
      "triggers": {
        "crons": ["*/15 * * * *"],
      },
    },
  },
}
