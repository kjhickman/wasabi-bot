{
  "name": "wasabi-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "check": "vp check && tsrs --noEmit && tsrs --noEmit -p voice",
    "test": "vp test run",
    "deploy": "CLOUDFLARE_ENV=prod vp build && wrangler deploy --secrets-file .dev.vars.prod",
    "postinstall": "wrangler types --include-env false && npm ci --prefix voice --no-audit --no-fund"
  },
  "dependencies": {
    "hono": "4.13.13",
    "openai": "7.41.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@types/node": "24.19.2",
    "discord-api-types": "0.38.57",
    "miniflare": "5.20261012.0-beta",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vite-plus": "1.3.0",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
